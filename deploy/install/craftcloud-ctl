#!/bin/sh
set -eu
umask 077
case $- in *x*) set +x ;; esac

INSTALL_ROOT=${CRAFTCLOUD_INSTALL_ROOT:-/opt/craftcloud}
CONFIG_DIR=${CRAFTCLOUD_CONFIG_DIR:-/etc/craftcloud}
saved_data_dir=$(sed -n 's/^CRAFTCLOUD_DATA_DIR=//p' "$CONFIG_DIR/craftcloud.env" 2>/dev/null | tail -n 1)
if [ -n "${CRAFTCLOUD_DATA_DIR:-}" ] && [ -n "$saved_data_dir" ] && [ "$CRAFTCLOUD_DATA_DIR" != "$saved_data_dir" ]; then
    printf '%s\n' 'craftcloud-ctl: CRAFTCLOUD_DATA_DIR differs from installed config' >&2
    exit 1
fi
DATA_DIR=${saved_data_dir:-${CRAFTCLOUD_DATA_DIR:-/var/lib/craftcloud}}
saved_project=$(sed -n 's/^CRAFTCLOUD_PROJECT_NAME=//p' "$CONFIG_DIR/craftcloud.env" 2>/dev/null | tail -n 1)
saved_caddy_dir=$(sed -n 's/^CRAFTCLOUD_CADDY_CONFIG_DIR=//p' "$CONFIG_DIR/craftcloud.env" 2>/dev/null | tail -n 1)
if [ -n "$saved_caddy_dir" ] && [ "$saved_caddy_dir" != "$CONFIG_DIR/caddy" ]; then
    printf '%s\n' 'craftcloud-ctl: Caddy config directory differs from installed config' >&2
    exit 1
fi
if [ -n "${CRAFTCLOUD_PROJECT_NAME:-}" ] && [ -n "$saved_project" ] && [ "$CRAFTCLOUD_PROJECT_NAME" != "$saved_project" ]; then
    printf '%s\n' 'craftcloud-ctl: CRAFTCLOUD_PROJECT_NAME differs from installed config' >&2
    exit 1
fi
PROJECT=${CRAFTCLOUD_PROJECT_NAME:-${saved_project:-craftcloud}}
saved_image_prefix=$(sed -n 's/^CRAFTCLOUD_IMAGE_PREFIX=//p' "$CONFIG_DIR/craftcloud.env" 2>/dev/null | tail -n 1)
if [ -n "${CRAFTCLOUD_IMAGE_PREFIX:-}" ] && [ -n "$saved_image_prefix" ] && [ "$CRAFTCLOUD_IMAGE_PREFIX" != "$saved_image_prefix" ]; then
    printf '%s\n' 'craftcloud-ctl: CRAFTCLOUD_IMAGE_PREFIX differs from installed config' >&2
    exit 1
fi
IMAGE_PREFIX=${CRAFTCLOUD_IMAGE_PREFIX:-$saved_image_prefix}
IMAGE_PREFIX=${IMAGE_PREFIX:-craftcloud:}
case $IMAGE_PREFIX in *[!A-Za-z0-9._:/-]*) printf '%s\n' 'craftcloud-ctl: invalid image prefix' >&2; exit 1 ;; esac
SYSTEMD_DIR=${CRAFTCLOUD_SYSTEMD_DIR:-/etc/systemd/system}
CURRENT=$INSTALL_ROOT/current
. "$(dirname -- "$0")/smtp-overrides.sh"
. "$(dirname -- "$0")/ops02.sh"
smtp_files=$(smtp_overrides "$CONFIG_DIR/craftcloud.env")

fail() { printf '%s\n' "craftcloud-ctl: $*" >&2; exit 1; }
systemd_running() {
    [ -d /run/systemd/system ] || [ "$(cat /proc/1/comm 2>/dev/null || true)" = systemd ]
}
valid_semver() {
    printf '%s\n' "$1" | awk '
        function identifiers(value, prerelease, parts, count, i) {
            if (value == "") return 0
            count = split(value, parts, /\./)
            for (i = 1; i <= count; i++) {
                if (parts[i] !~ /^[0-9A-Za-z-]+$/) return 0
                if (prerelease && parts[i] ~ /^[0-9]+$/ && length(parts[i]) > 1 && substr(parts[i], 1, 1) == "0") return 0
            }
            return 1
        }
        {
            value = $0
            plus = index(value, "+")
            if (plus) { build = substr(value, plus + 1); value = substr(value, 1, plus - 1); if (index(build, "+") || !identifiers(build, 0)) exit 1 }
            dash = index(value, "-")
            if (dash) { prerelease = substr(value, dash + 1); value = substr(value, 1, dash - 1); if (!identifiers(prerelease, 1)) exit 1 }
            if (split(value, core, /\./) != 3) exit 1
            for (i = 1; i <= 3; i++) if (core[i] !~ /^[0-9]+$/ || (length(core[i]) > 1 && substr(core[i], 1, 1) == "0")) exit 1
        }
    '
}
image_tag() { printf '%s\n' "$1" | sed 's/+/_/'; }
safe_path() {
    safe_value=$1
    case $safe_value in /*) ;; *) fail 'install, config, and data paths must be absolute' ;; esac
    case $safe_value in /|*//*|*/|*/./*|*/../*|*/.|*/..) fail "unsafe path: $safe_value" ;; esac
    case $safe_value in *[!A-Za-z0-9/._-]*) fail 'paths may contain only letters, digits, slash, dot, underscore, and hyphen' ;; esac
    safe_rest=${safe_value#/}
    safe_parent=
    while [ -n "$safe_rest" ]; do
        case $safe_rest in */*) safe_part=${safe_rest%%/*}; safe_rest=${safe_rest#*/} ;; *) safe_part=$safe_rest; safe_rest= ;; esac
        [ -n "$safe_part" ] || fail "unsafe path: $safe_value"
        safe_parent=$safe_parent/$safe_part
        [ ! -L "$safe_parent" ] || fail "path contains a symbolic link: $safe_parent"
    done
}
paths_overlap() {
    case $1/ in "$2/"*) return 0 ;; esac
    case $2/ in "$1/"*) return 0 ;; esac
    return 1
}
installation_identity() { printf '%s|%s|%s|%s\n' "$INSTALL_ROOT" "$CONFIG_DIR" "$DATA_DIR" "$PROJECT"; }
require_owned_root() {
    owned_root=$1
    owned_marker=$owned_root/.craftcloud-installation
    case $owned_root in /opt|/etc|/var|/var/lib|/home|/root|/usr|/tmp|/srv|/mnt) fail "refusing broad system directory: $owned_root" ;; esac
    [ ! -L "$owned_root" ] || fail "installation root is a symbolic link: $owned_root"
    [ -d "$owned_root" ] || fail "installation root missing: $owned_root"
    [ -f "$owned_marker" ] && [ ! -L "$owned_marker" ] || fail "installation marker missing: $owned_marker"
    [ "$(cat "$owned_marker")" = "$(installation_identity)" ] || fail "installation marker does not match this instance: $owned_root"
}
verify_archive_checksum() {
    checksum_file=$(dirname -- "$1")/SHA256SUMS
    [ -f "$checksum_file" ] || fail 'SHA256SUMS missing beside archive'
    checksum_name=$(basename -- "$1")
    checksum_expected=
    checksum_matches=0
    while IFS=' ' read -r checksum_hash checksum_file_name checksum_extra || [ -n "${checksum_hash:-}" ]; do
        case $checksum_file_name in "$checksum_name")
            checksum_matches=$((checksum_matches + 1))
            [ -z "${checksum_extra:-}" ] || fail 'malformed checksum entry'
            [ "${#checksum_hash}" -eq 64 ] || fail 'malformed archive checksum'
            case $checksum_hash in *[!0-9a-fA-F]*) fail 'malformed archive checksum' ;; esac
            checksum_expected=$checksum_hash
            ;;
        esac
    done <"$checksum_file"
    [ "$checksum_matches" -eq 1 ] || fail 'SHA256SUMS must contain exactly one checksum for the archive'
    checksum_actual=$(sha256sum "$1" | awk '{print $1}')
    [ "$checksum_actual" = "$checksum_expected" ] || fail 'archive checksum mismatch'
}
set_config_image() {
    env_file=$CONFIG_DIR/craftcloud.env
    tmp=$env_file.tmp.$$
    awk '!/^CRAFTCLOUD_IMAGE=/' "$env_file" >"$tmp"
    tag=$(image_tag "$1")
    [ "${#tag}" -le 128 ] || fail 'release version is too long for a Docker image tag'
    printf 'CRAFTCLOUD_IMAGE=%s%s\n' "$IMAGE_PREFIX" "$tag" >>"$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$env_file"
}
current_release() {
    [ -L "$CURRENT" ] || fail 'current release symlink missing'
    target=$(readlink -f "$CURRENT")
    case $target in "$INSTALL_ROOT"/releases/*) ;; *) fail 'current release points outside releases directory' ;; esac
    [ -d "$target/deploy/compose" ] || [ -d "$target/craftcloud-$(basename "$target")/deploy/compose" ] || fail 'active release is incomplete'
    printf '%s\n' "$target"
}
release_compose_dir() {
    if [ -d "$1/deploy/compose" ]; then printf '%s\n' "$1/deploy/compose"
    else printf '%s\n' "$1/craftcloud-$(basename "$1")/deploy/compose"; fi
}
version_of() {
    name=$(basename -- "$1")
    printf '%s\n' "$name" | sed 's/^craftcloud-//'
}
# The FigCraft companion setting in the environment file. A configuration without
# the line predates the setting and stays off until `upgrade` or `figcraft enable`
# records it (and creates the key file).
figcraft_setting() {
    fig_value=$(sed -n 's/^CRAFTCLOUD_FIGCRAFT=//p' "$CONFIG_DIR/craftcloud.env" 2>/dev/null | tail -n 1)
    case $fig_value in
        enabled|disabled) printf '%s\n' "$fig_value" ;;
        '') printf '%s\n' disabled ;;
        *) printf '%s\n' 'craftcloud-ctl: CRAFTCLOUD_FIGCRAFT must be enabled or disabled' >&2; return 1 ;;
    esac
}
# compose_run <release-root> <with-setup 0|1> <docker compose arguments...>
# The single place that decides which Compose files every invocation uses.
compose_run() {
    root=$1; setup=$2; shift 2
    dir=$(release_compose_dir "$root")
    version=$(version_of "$root")
    tag=$(image_tag "$version")
    [ "${#tag}" -le 128 ] || fail 'release version is too long for a Docker image tag'
    fig=$(figcraft_setting) || exit 1
    files='-f compose.yaml -f compose.install.yaml'
    if [ "$fig" = enabled ]; then
        if [ -f "$dir/compose.figcraft.yaml" ]; then
            files="$files -f compose.figcraft.yaml"
        else
            printf '%s\n' "craftcloud-ctl: warning: release $version has no compose.figcraft.yaml; running it without the FigCraft companion" >&2
            fig=disabled
        fi
    fi
    # smtp_files contains only fixed -f filenames emitted by smtp_overrides;
    # overlays missing from an older release are dropped with a warning.
    # Database and proxy choices (OPS-02) are recorded in the environment file.
    ops_files=$(ops_overlay_files "$CONFIG_DIR/craftcloud.env" "$dir" "$fig") || exit 1
    files="$files$ops_files"
    release_smtp_files=$(smtp_release_files "$dir" "$smtp_files" "$version")
    [ -z "$release_smtp_files" ] || files="$files $release_smtp_files"
    [ "$setup" != 1 ] || files="$files -f compose.setup.yaml"
    export CRAFTCLOUD_IMAGE="$IMAGE_PREFIX$tag"
    export CRAFTCLOUD_DATA_DIR="$DATA_DIR" CRAFTCLOUD_CONFIG_DIR="$CONFIG_DIR"
    # shellcheck disable=SC2086 # the file list is intentionally word-split
    (cd "$dir" && docker compose --project-name "$PROJECT" --env-file "$CONFIG_DIR/craftcloud.env" $files "$@")
}
compose_at() {
    root=$1; shift
    compose_run "$root" 0 "$@"
}
compose_at_setup() {
    root=$1; shift
    compose_run "$root" 1 "$@"
}
compose_for_setup_state() {
    if [ -f "$CONFIG_DIR/bootstrap-token" ]; then compose_at_setup "$@"
    else compose_at "$@"; fi
}
release_complete() {
    # release_complete <release-dir> <version>
    if [ -d "$1/deploy/compose" ] && [ -f "$1/CRAFTCLOUD-RELEASE.json" ]; then return 0; fi
    [ -d "$1/craftcloud-$2/deploy/compose" ] && [ -f "$1/craftcloud-$2/CRAFTCLOUD-RELEASE.json" ]
}
# extract_release <archive> <version> <destination>
# Unpacks into a staging directory next to the destination and renames it only
# after the content is validated, so a failed run never leaves a partial release.
extract_release() {
    ex_archive=$1
    ex_version=$2
    ex_dest=$3
    ex_stage=$INSTALL_ROOT/releases/.tmp-$ex_version.$$
    rm -rf -- "$INSTALL_ROOT/releases/.tmp-$ex_version".*
    rm -rf -- "$ex_stage"
    mkdir "$ex_stage"
    trap 'rm -rf -- "$ex_stage"' 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    ex_entries=$(tar -tzf "$ex_archive") || fail 'cannot read archive table of contents'
    printf '%s\n' "$ex_entries" | awk -v root="craftcloud-$ex_version" '($0 != root "/" && index($0, root "/") != 1) || /^\// || /(^|\/)\.\.($|\/)/ {bad=1} END {exit bad}' || fail 'archive contains unsafe paths'
    ex_types=$(tar -tvzf "$ex_archive") || fail 'cannot inspect archive entry types'
    printf '%s\n' "$ex_types" | awk 'substr($0,1,1) != "-" && substr($0,1,1) != "d" {bad=1} END {exit bad}' || fail 'archive contains links or special files'
    umask 022
    tar -xzf "$ex_archive" -C "$ex_stage" --no-same-owner --strip-components=1
    umask 077
    release_complete "$ex_stage" "$ex_version" || fail 'release archive is incomplete (deploy/compose or CRAFTCLOUD-RELEASE.json missing)'
    mv -T "$ex_stage" "$ex_dest"
    trap - 0 HUP INT TERM
}
# sync_caddy_config <shipped-dir> <config-dir>
# Refreshes release-shipped Caddy files. Operator-owned files (fullchain.pem,
# private.key, and anything the release does not ship) are never touched. A
# shipped file the operator changed is kept and the new version is written
# beside it as <name>.new. Hashes of the shipped versions are recorded in
# .shipped-sha256 to tell an unmodified file from an edited one.
sync_caddy_config() {
    sync_src=$1
    sync_dest=$2
    sync_manifest=$sync_dest/.shipped-sha256
    sync_next=$sync_manifest.tmp.$$
    CADDY_CHANGED=0
    : >"$sync_next"
    for sync_file in "$sync_src"/*; do
        [ -f "$sync_file" ] && [ ! -L "$sync_file" ] || continue
        sync_name=${sync_file##*/}
        case $sync_name in fullchain.pem|private.key|*.new) continue ;; esac
        sync_target=$sync_dest/$sync_name
        sync_new=$(sha256sum "$sync_file" | awk '{print $1}')
        sync_old=
        [ ! -f "$sync_manifest" ] || sync_old=$(awk -v n="$sync_name" '$2 == n {print $1}' "$sync_manifest")
        if [ -L "$sync_target" ]; then
            printf '%s\n' "craftcloud: warning: $sync_target is a symbolic link; not refreshed" >&2
            [ -z "$sync_old" ] || printf '%s  %s\n' "$sync_old" "$sync_name" >>"$sync_next"
        elif [ ! -e "$sync_target" ]; then
            cp "$sync_file" "$sync_target"
            CADDY_CHANGED=1
            printf '%s  %s\n' "$sync_new" "$sync_name" >>"$sync_next"
        else
            sync_cur=$(sha256sum "$sync_target" | awk '{print $1}')
            if [ "$sync_cur" = "$sync_new" ]; then
                rm -f -- "$sync_target.new"
                printf '%s  %s\n' "$sync_new" "$sync_name" >>"$sync_next"
            elif [ -n "$sync_old" ] && [ "$sync_old" = "$sync_cur" ]; then
                cp "$sync_file" "$sync_target.tmp.$$"
                mv -f "$sync_target.tmp.$$" "$sync_target"
                CADDY_CHANGED=1
                rm -f -- "$sync_target.new"
                printf '%s  %s\n' "$sync_new" "$sync_name" >>"$sync_next"
                printf '%s\n' "craftcloud: refreshed Caddy file $sync_name"
            else
                cp "$sync_file" "$sync_target.new"
                printf '%s\n' "craftcloud: warning: Caddy file $sync_name was changed locally and is kept; the new shipped version is $sync_target.new. Compare and merge it." >&2
                [ -z "$sync_old" ] || printf '%s  %s\n' "$sync_old" "$sync_name" >>"$sync_next"
            fi
        fi
    done
    chmod 0600 "$sync_next"
    mv -f "$sync_next" "$sync_manifest"
}
# Generates the Base64 two-factor key (32 random bytes) and prints it.
generate_two_factor_key() {
    gen_key=$(head -c 32 /dev/urandom | base64 | tr -d '\n') || fail 'cannot generate two-factor key'
    [ "${#gen_key}" -eq 44 ] || fail 'cannot generate two-factor key'
    printf '%s' "$gen_key"
}
# env_set <name> <value>: replaces or appends one line of the environment file.
env_set() {
    set_env=$CONFIG_DIR/craftcloud.env
    set_tmp=$set_env.tmp.$$
    { awk -v prefix="$1=" 'index($0, prefix) != 1' "$set_env"; printf '%s=%s\n' "$1" "$2"; } >"$set_tmp"
    chmod 0600 "$set_tmp"
    mv -f "$set_tmp" "$set_env"
}
# Generates the FigCraft management key (64 random hex characters) and prints it.
generate_figcraft_key() {
    gen_fig=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
    [ "${#gen_fig}" -eq 64 ] || fail 'cannot generate FigCraft key'
    printf '%s' "$gen_fig"
}
# Prepares everything the FigCraft companion needs: the management key file
# (created once, mode 0600, never printed and never replaced), its path and the
# public wss URL in the environment file, and the Caddy mount point of the route.
ensure_figcraft_files() {
    fig_env=$CONFIG_DIR/craftcloud.env
    fig_key=$CONFIG_DIR/figcraft.key
    [ ! -L "$fig_key" ] || fail 'FigCraft key path must not be a symbolic link'
    if [ ! -e "$fig_key" ]; then
        command -v od >/dev/null 2>&1 || fail 'required command missing: od'
        fig_tmp=$fig_key.tmp.$$
        generate_figcraft_key >"$fig_tmp"
        chmod 0600 "$fig_tmp"
        mv -f "$fig_tmp" "$fig_key"
    else
        [ -f "$fig_key" ] || fail 'FigCraft key path is not a regular file'
        grep -Eq '^[0-9A-Fa-f]{64}$' "$fig_key" || fail "existing $fig_key is not 64 hexadecimal characters; refusing to replace it"
        chmod 0600 "$fig_key"
    fi
    env_set CRAFTCLOUD_FIGCRAFT_SECRET_FILE "$fig_key"
    if ! grep -q '^CRAFTCLOUD_FIGCRAFT_PUBLIC_URL=.' "$fig_env"; then
        fig_domain=$(sed -n 's/^CRAFTCLOUD_DOMAIN=//p' "$fig_env" | tail -n 1)
        fig_port=$(sed -n 's/^CRAFTCLOUD_HTTPS_PORT=//p' "$fig_env" | tail -n 1)
        [ -n "$fig_domain" ] || fail 'CRAFTCLOUD_DOMAIN missing in the environment file'
        fig_url=wss://$fig_domain/figcraft/
        [ -z "$fig_port" ] || [ "$fig_port" = 443 ] || fig_url=wss://$fig_domain:$fig_port/figcraft/
        env_set CRAFTCLOUD_FIGCRAFT_PUBLIC_URL "$fig_url"
    fi
    mkdir -p "$CONFIG_DIR/caddy/optional"
    chmod 0700 "$CONFIG_DIR/caddy/optional"
    [ -e "$CONFIG_DIR/caddy/optional/figcraft.caddy" ] || : >"$CONFIG_DIR/caddy/optional/figcraft.caddy"
}
# Environment files from before the FigCraft setting existed get the default (enabled).
ensure_figcraft_setting() {
    if ! grep -q '^CRAFTCLOUD_FIGCRAFT=' "$CONFIG_DIR/craftcloud.env"; then env_set CRAFTCLOUD_FIGCRAFT enabled; fi
    fig_now=$(figcraft_setting) || exit 1
    if [ "$fig_now" = enabled ]; then ensure_figcraft_files; fi
}
# Adds CC_SECRET_TWO_FACTOR_KEY to an environment file written before the key
# existed. An existing non-empty value is never changed.
ensure_two_factor_key() {
    ensure_env=$CONFIG_DIR/craftcloud.env
    if grep -q '^CC_SECRET_TWO_FACTOR_KEY=.' "$ensure_env"; then return 0; fi
    command -v base64 >/dev/null 2>&1 || fail 'required command missing: base64'
    ensure_key=$(generate_two_factor_key)
    ensure_tmp=$ensure_env.tmp.$$
    { awk '!/^CC_SECRET_TWO_FACTOR_KEY=/' "$ensure_env"; printf 'CC_SECRET_TWO_FACTOR_KEY=%s\n' "$ensure_key"; } >"$ensure_tmp"
    chmod 0600 "$ensure_tmp"
    mv -f "$ensure_tmp" "$ensure_env"
    printf '%s\n' "craftcloud-ctl: generated a two-factor encryption key in $ensure_env (keep a separate protected copy; backups do not contain it)"
}
# read_setup_status <release-root>: the JSON of GET /api/v1/setup/status. With the
# bundled Caddy it is read through that container; with your own proxy through
# the loopback port the server publishes (curl or wget on the host).
read_setup_status() {
    rss_proxy=$(ops_env_get "$CONFIG_DIR/craftcloud.env" CRAFTCLOUD_PROXY)
    case ${rss_proxy:-caddy} in
        caddy) compose_at_setup "$1" exec -T caddy wget -qO- http://server:8080/api/v1/setup/status ;;
        *)
            rss_port=$(ops_env_get "$CONFIG_DIR/craftcloud.env" CRAFTCLOUD_LOCAL_PORT)
            rss_url=http://127.0.0.1:${rss_port:-8080}/api/v1/setup/status
            if command -v curl >/dev/null 2>&1; then curl -fsS --max-time 10 "$rss_url"
            elif command -v wget >/dev/null 2>&1; then wget -qO- -T 10 "$rss_url"
            else fail 'curl or wget is required to read the setup status when your own proxy is used'; fi
            ;;
    esac
}
# Recreates the proxy so that refreshed Caddy files take effect (the directory is a
# read-only bind mount; Caddy reads it at start).
recreate_caddy_if_changed() {
    [ "${CADDY_CHANGED:-0}" -eq 1 ] || return 0
    # With your own proxy the bundled Caddy is not part of the installation.
    proxy_now=$(ops_env_get "$CONFIG_DIR/craftcloud.env" CRAFTCLOUD_PROXY)
    [ -z "$proxy_now" ] || [ "$proxy_now" = caddy ] || return 0
    compose_for_setup_state "$1" up -d --force-recreate --no-deps caddy || printf '%s\n' 'craftcloud-ctl: warning: could not recreate the proxy; restart it to load the refreshed Caddy files' >&2
}
# Commands that change the installation (backup, upgrade, rollback, setup-complete,
# uninstall) exclude each other. Child
# invocations of this script started by a locked command skip the lock.
acquire_lock() {
    [ "${CRAFTCLOUD_CTL_LOCK_HELD:-0}" != 1 ] || return 0
    command -v flock >/dev/null 2>&1 || fail 'flock (util-linux) is required to serialize commands that change the installation'
    exec 9>"$CONFIG_DIR/.ctl.lock"
    flock -n 9 || fail 'another craftcloud-ctl command that changes the installation is running; retry when it has finished'
    CRAFTCLOUD_CTL_LOCK_HELD=1
    export CRAFTCLOUD_CTL_LOCK_HELD
}
safe_path "$INSTALL_ROOT"
safe_path "$CONFIG_DIR"
safe_path "$DATA_DIR"
safe_path "$INSTALL_ROOT/releases"
safe_path "$DATA_DIR/backups"
if paths_overlap "$INSTALL_ROOT" "$CONFIG_DIR" || paths_overlap "$INSTALL_ROOT" "$DATA_DIR" || paths_overlap "$CONFIG_DIR" "$DATA_DIR"; then
    fail 'install, config, and data directories must not overlap'
fi
require_owned_root "$INSTALL_ROOT"
require_owned_root "$CONFIG_DIR"
require_owned_root "$DATA_DIR"
active=$(current_release)

case ${1:-} in
    status)
        compose_at "$active" ps
        if grep -q '^CC_SECRET_TWO_FACTOR_KEY=.' "$CONFIG_DIR/craftcloud.env"; then
            printf '%s\n' "Two-factor key: present in $CONFIG_DIR/craftcloud.env"
        else
            printf '%s\n' "Two-factor key: MISSING in $CONFIG_DIR/craftcloud.env (two-factor setup is unavailable until it exists)"
        fi
        fig_status=$(figcraft_setting) || exit 1
        printf '%s\n' "FigCraft live companion: $fig_status (change with: craftcloud-ctl figcraft enable|disable)"
        printf '%s\n' "Database: $(ops_env_get "$CONFIG_DIR/craftcloud.env" CRAFTCLOUD_DB | sed 's/^$/bundled/'); reverse proxy: $(ops_env_get "$CONFIG_DIR/craftcloud.env" CRAFTCLOUD_PROXY | sed 's/^$/caddy/')"
        ;;
    logs) shift; compose_at "$active" logs --follow "$@" ;;
    backup)
        acquire_lock
        need_keep=${CRAFTCLOUD_BACKUP_KEEP:-$(sed -n 's/^CRAFTCLOUD_BACKUP_KEEP=//p' "$CONFIG_DIR/craftcloud.env" | tail -n 1)}
        need_keep=${need_keep:-7}
        case $need_keep in *[!0-9]*|'') fail 'CRAFTCLOUD_BACKUP_KEEP must be a positive integer' ;; esac
        [ "$need_keep" -gt 0 ] || fail 'CRAFTCLOUD_BACKUP_KEEP must be a positive integer'
        name=$(date -u +%Y%m%dT%H%M%SZ)-$$
        compose_for_setup_state "$active" run --rm backup admin backup create --out "/backups/$name"
        backup_path=$DATA_DIR/backups/$name
        printf '%s\n' "$backup_path" >"$CONFIG_DIR/last-backup"
        chmod 0600 "$CONFIG_DIR/last-backup"
        verified_file=$(mktemp "$CONFIG_DIR/.backup-retention.XXXXXX")
        chmod 0600 "$verified_file"
        for path in "$DATA_DIR"/backups/*; do
            [ -d "$path" ] && [ ! -L "$path" ] || continue
            name=${path##*/}
            printf '%s\n' "$name" | awk '/^[0-9]{8}T[0-9]{6}Z-[0-9]+$/ {ok=1} END {exit !ok}' || continue
            [ -f "$path/manifest.json" ] && [ ! -L "$path/manifest.json" ] || continue
            [ -f "$path/manifest.sha256" ] && [ ! -L "$path/manifest.sha256" ] || continue
            if compose_for_setup_state "$active" run --rm --no-deps backup admin backup verify "/backups/$name" >/dev/null 2>&1; then
                printf '%s\n' "$path" >>"$verified_file"
            fi
        done
        count=$(wc -l <"$verified_file")
        remove_count=$((count - need_keep))
        while [ "$remove_count" -gt 0 ] && IFS= read -r path; do
            rm -rf -- "$path"
            remove_count=$((remove_count - 1))
        done <"$verified_file"
        rm -f -- "$verified_file"
        printf 'Backup created: %s\n' "$backup_path"
        printf '%s\n' "The backup does not contain the two-factor encryption key. It lives in $CONFIG_DIR/craftcloud.env (CC_SECRET_TWO_FACTOR_KEY); keep a separate protected copy, a restore needs the same key."
        ;;
    start)
        if [ -f "$CONFIG_DIR/bootstrap-token" ]; then compose_at_setup "$active" up -d
        else compose_at "$active" up -d; fi
        ;;
    stop) compose_at "$active" down ;;
    setup-complete)
        acquire_lock
        [ -f "$CONFIG_DIR/bootstrap-token" ] || fail 'bootstrap secret file not present'
        setup_status=$(read_setup_status "$active") || fail 'cannot read setup status'
        case $setup_status in *'"setup_required":false'*) ;; *) fail 'instance setup is not complete' ;; esac
        env_file=$CONFIG_DIR/craftcloud.env
        env_backup=$CONFIG_DIR/.craftcloud.env.$$
        cp "$env_file" "$env_backup"
        chmod 0600 "$env_backup"
        env_tmp=$CONFIG_DIR/.craftcloud.env.tmp.$$
        awk '/^CC_SECRET_BOOTSTRAP=/ {print "CC_SECRET_BOOTSTRAP="; next} {print}' "$env_file" >"$env_tmp"
        chmod 0600 "$env_tmp"
        mv -f "$env_tmp" "$env_file"
        if ! compose_at "$active" up -d; then
            mv -f "$env_backup" "$env_file"
            compose_at_setup "$active" up -d || true
            fail 'could not disable bootstrap; setup overlay restored'
        fi
        tries=0
        until compose_at "$active" exec -T server /usr/local/bin/craftcloud-server healthcheck >/dev/null 2>&1; do
            tries=$((tries + 1))
            if [ "$tries" -ge 60 ]; then
                mv -f "$env_backup" "$env_file"
                compose_at_setup "$active" up -d || true
                fail 'could not disable bootstrap; setup overlay restored'
            fi
            sleep 2
        done
        rm -f -- "$CONFIG_DIR/bootstrap-token" "$env_backup"
        printf '%s\n' 'Bootstrap disabled after completed setup.'
        ;;
    upgrade)
        acquire_lock
        image_archive=
        case $# in
            2) ;;
            4) [ "$3" = --image-archive ] || fail 'usage: craftcloud-ctl upgrade <archive.tar.gz> [--image-archive <image.tar.zst>]'; image_archive=$4 ;;
            *) fail 'usage: craftcloud-ctl upgrade <archive.tar.gz> [--image-archive <image.tar.zst>]' ;;
        esac
        archive=$2
        [ -z "$image_archive" ] || [ -f "$image_archive" ] || fail 'image archive not found'
        [ -f "$archive" ] || fail 'archive not found'
        verify_archive_checksum "$archive"
        archive_name=$(basename -- "$archive")
        new_version=$(printf '%s' "$archive_name" | sed -n 's/^craftcloud-\([0-9][0-9A-Za-z.+-]*\)\.tar\.gz$/\1/p')
        [ -n "$new_version" ] || fail 'invalid release archive name'
        valid_semver "$new_version" || fail 'release version must be valid SemVer'
        new_image_tag=$(image_tag "$new_version")
        [ "${#new_image_tag}" -le 128 ] || fail 'release version is too long for a Docker image tag'
        new_root=$INSTALL_ROOT/releases/$new_version
        [ "$new_root" != "$active" ] || fail 'release is already active'
        [ ! -L "$new_root" ] || fail 'release destination is a symbolic link'
        # Environment files from before the two-factor key existed get one now.
        ensure_two_factor_key
        ensure_figcraft_setting
        # A backup must finish before any release or database change.
        sh "$0" backup
        backup_path=$(cat "$CONFIG_DIR/last-backup")
        printf '%s\n' "$backup_path" >"$CONFIG_DIR/upgrade-backup"
        chmod 0600 "$CONFIG_DIR/upgrade-backup"
        mkdir -p "$INSTALL_ROOT/releases"
        if [ -e "$new_root" ] && ! release_complete "$new_root" "$new_version"; then
            # Leftover of an interrupted older run; it is not active (checked above).
            rm -rf -- "$new_root"
        fi
        if [ ! -e "$new_root" ]; then
            extract_release "$archive" "$new_version" "$new_root"
        fi
        new_dir=$(release_compose_dir "$new_root")
        metadata=$new_root/CRAFTCLOUD-RELEASE.json
        [ -f "$metadata" ] || metadata=$new_root/craftcloud-$new_version/CRAFTCLOUD-RELEASE.json
        [ -f "$metadata" ] || fail 'CRAFTCLOUD-RELEASE.json missing'
        commit=$(sed -n 's/.*"commit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$metadata")
        metaver=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$metadata")
        [ "$metaver" = "$new_version" ] && [ -n "$commit" ] || fail 'release metadata mismatch'
        export CRAFTCLOUD_IMAGE="$IMAGE_PREFIX$new_image_tag" CRAFTCLOUD_DATA_DIR="$DATA_DIR" CRAFTCLOUD_CONFIG_DIR="$CONFIG_DIR"
        if [ -n "$image_archive" ]; then
            # The prebuilt image replaces the long build on this server.
            ops_load_image_archive "$image_archive" "$new_version" "$CRAFTCLOUD_IMAGE"
        else
            # One image serves server, migrate, backup, restore and the FigCraft companion.
            build_services='migrate server backup restore'
            # shellcheck disable=SC2086 # the service list is intentionally word-split
            compose_at "$new_root" build --build-arg "CRAFTCLOUD_VERSION=$new_version" --build-arg "CRAFTCLOUD_COMMIT=$commit" $build_services
        fi
        restore_warning=0
        trap 'upgrade_status=$?; if [ "$restore_warning" -eq 1 ] && [ "$upgrade_status" -ne 0 ]; then printf "%s\\n" "Upgrade failed after migration attempt. Pre-upgrade backup: $backup_path. Restore manually if needed; see docs/06-operations/backup-upgrade-runbook.md. No automatic restore performed." >&2; fi' 0
        restore_warning=1
        if [ -f "$CONFIG_DIR/bootstrap-token" ]; then
            compose_at_setup "$new_root" run --rm migrate
        else
            compose_at "$new_root" run --rm migrate
        fi
        sync_caddy_config "$new_dir/caddy" "$CONFIG_DIR/caddy"
        previous=$CONFIG_DIR/previous-release
        printf '%s\n' "$active" >"$previous"
        chmod 0600 "$previous"
        set_config_image "$new_version"
        rm -f -- "$INSTALL_ROOT/current.new"
        ln -s "$new_root" "$INSTALL_ROOT/current.new"
        mv -Tf "$INSTALL_ROOT/current.new" "$CURRENT"
        if ! compose_for_setup_state "$new_root" up -d; then
            sh "$0" rollback
            exit 1
        fi
        tries=0
        until compose_at "$new_root" exec -T server /usr/local/bin/craftcloud-server healthcheck >/dev/null 2>&1; do
            tries=$((tries + 1)); [ "$tries" -lt 60 ] || {
                sh "$0" rollback
                exit 1
            }
            sleep 2
        done
        recreate_caddy_if_changed "$new_root"
        trap - 0
        ;;
    rollback)
        acquire_lock
        previous=$CONFIG_DIR/previous-release
        [ -f "$previous" ] || fail 'no previous release recorded'
        old=$(cat "$previous")
        [ -d "$old" ] || fail 'previous release directory missing'
        case $old in "$INSTALL_ROOT"/releases/*) ;; *) fail 'previous release points outside releases directory' ;; esac
        old_version=${old##*/}
        valid_semver "$old_version" || fail 'previous release version is invalid'
        [ "$old" = "$INSTALL_ROOT/releases/$old_version" ] || fail 'previous release must be a direct child of releases'
        [ ! -L "$old" ] || fail 'previous release is a symbolic link'
        set_config_image "$(version_of "$old")"
        rm -f -- "$INSTALL_ROOT/current.new"
        ln -s "$old" "$INSTALL_ROOT/current.new"
        mv -Tf "$INSTALL_ROOT/current.new" "$CURRENT"
        # The proxy configuration follows the release that becomes active again.
        sync_caddy_config "$(release_compose_dir "$old")/caddy" "$CONFIG_DIR/caddy"
        compose_for_setup_state "$old" up -d
        recreate_caddy_if_changed "$old"
        printf '%s\n' 'Release rolled back. Database schema was not restored; restore the pre-upgrade backup if the prior release requires it.' >&2
        ;;
    figcraft)
        sub=${2:-status}
        case $sub in
            status)
                fig_status=$(figcraft_setting) || exit 1
                printf 'FigCraft live companion: %s\n' "$fig_status"
                ;;
            enable|disable)
                acquire_lock
                if [ "$sub" = enable ]; then new_setting=enabled; else new_setting=disabled; fi
                old_setting=$(figcraft_setting) || exit 1
                if [ "$sub" = enable ]; then
                    [ -f "$(release_compose_dir "$active")/compose.figcraft.yaml" ] || fail 'the active release has no compose.figcraft.yaml'
                    command -v od >/dev/null 2>&1 || fail 'required command missing: od'
                fi
                had_setting=0
                grep -q '^CRAFTCLOUD_FIGCRAFT=' "$CONFIG_DIR/craftcloud.env" && had_setting=1
                env_set CRAFTCLOUD_FIGCRAFT "$new_setting"
                restore_figcraft_setting() {
                    if [ "$had_setting" -eq 1 ]; then env_set CRAFTCLOUD_FIGCRAFT "$old_setting"
                    else awk '!/^CRAFTCLOUD_FIGCRAFT=/' "$CONFIG_DIR/craftcloud.env" >"$CONFIG_DIR/.craftcloud.env.tmp.$$" && chmod 0600 "$CONFIG_DIR/.craftcloud.env.tmp.$$" && mv -f "$CONFIG_DIR/.craftcloud.env.tmp.$$" "$CONFIG_DIR/craftcloud.env"; fi
                }
                if [ "$sub" = enable ]; then
                    ensure_figcraft_files
                    # The FigCraft server is part of the CraftCloud image; nothing to build.
                else
                    printf '%s\n' 'craftcloud-ctl: warning: disabling FigCraft live collaboration. Active live files become unavailable and their links stop working. End live files in the cloud first so the last state is saved as a version; the data stays in the figcraft-data volume and the key stays in the config directory for a later enable.' >&2
                fi
                # --remove-orphans removes the figcraft containers when the overlay is gone.
                if ! compose_for_setup_state "$active" up -d --remove-orphans; then
                    restore_figcraft_setting
                    fail "could not apply the FigCraft setting; the previous value ($old_setting) was restored, run 'craftcloud-ctl start' to reapply it"
                fi
                tries=0
                until compose_at "$active" exec -T server /usr/local/bin/craftcloud-server healthcheck >/dev/null 2>&1; do
                    tries=$((tries + 1)); [ "$tries" -lt 60 ] || fail 'readiness check timed out after changing the FigCraft setting'
                    sleep 2
                done
                printf 'FigCraft live companion: %s\n' "$new_setting"
                ;;
            *) fail 'usage: craftcloud-ctl figcraft [status|enable|disable]' ;;
        esac
        ;;
    uninstall)
        acquire_lock
        shift
        purge=0 confirm=0
        for arg in "$@"; do case $arg in --purge) purge=1 ;; --confirm-purge) confirm=1 ;; *) fail "unknown uninstall option: $arg" ;; esac; done
        [ "$confirm" -eq 0 ] || [ "$purge" -eq 1 ] || fail '--confirm-purge requires --purge'
        if [ "$purge" -eq 1 ] && [ "$confirm" -ne 1 ]; then
            [ -t 0 ] || fail '--purge requires --confirm-purge on non-interactive input'
            printf 'Delete all CraftCloud data and config? Type DELETE: '
            IFS= read -r answer
            [ "$answer" = DELETE ] || fail 'purge cancelled'
        fi
        if [ "${CRAFTCLOUD_SKIP_SYSTEMD:-0}" != 1 ]; then
            command -v systemctl >/dev/null 2>&1 || fail 'systemctl required for uninstall; set CRAFTCLOUD_SKIP_SYSTEMD=1 only in a test container'
            systemd_running || fail 'systemd is not running; set CRAFTCLOUD_SKIP_SYSTEMD=1 only in a test container'
            # Units are missing when an installation stopped before systemd setup.
            for unit in craftcloud-backup.timer craftcloud.service craftcloud-backup.service; do
                [ -e "$SYSTEMD_DIR/$unit" ] || continue
                systemctl disable --now "$unit" >/dev/null || printf '%s\n' "craftcloud-ctl: warning: could not disable $unit" >&2
            done
        else
            systemd_running && fail 'CRAFTCLOUD_SKIP_SYSTEMD=1 is allowed only outside a systemd host'
        fi
        if [ "$purge" -eq 1 ]; then compose_at "$active" down --volumes
        else compose_at "$active" down; fi
        rm -f "$SYSTEMD_DIR/craftcloud.service" "$SYSTEMD_DIR/craftcloud-backup.service" "$SYSTEMD_DIR/craftcloud-backup.timer"
        if [ "${CRAFTCLOUD_SKIP_SYSTEMD:-0}" != 1 ]; then systemctl daemon-reload; fi
        rm -rf -- "$INSTALL_ROOT"
        if [ "$purge" -eq 1 ]; then
            rm -rf -- "$DATA_DIR" "$CONFIG_DIR"
        fi
        ;;
    *) fail 'usage: craftcloud-ctl status|logs|backup|upgrade <archive> [--image-archive <image>]|rollback|setup-complete|figcraft [status|enable|disable]|uninstall [--purge --confirm-purge]' ;;
esac
